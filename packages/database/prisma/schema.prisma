generator client {
  provider     = "prisma-client-js"
  output       = "../../../apps/web/prisma/generated/client"
  binaryTargets = ["native", "rhel-openssl-3.0.x"]
}

datasource db {
  provider = "mongodb"
  url      = env("DATABASE_URL")
}

model Settings {
  id                        String    @id @map("_id") @default(auto()) @db.ObjectId
  tradingEnabled            Boolean   @default(true)
  liveTradingAcknowledgedAt DateTime?
  dailyLossLimit            String?
  equity                    String?
  peakEquity                String?
  breakerTripped            Boolean   @default(false)
  breakerReason             String?
  breakerDailyPnl           String?
  createdAt                 DateTime  @default(now())
  updatedAt                 DateTime  @updatedAt
}

model WebhookEndpoint {
  id            String   @id @map("_id") @default(auto()) @db.ObjectId
  name          String
  signingSecret String
  active        Boolean  @default(true)
  lastNonce     String?
  lastNonceAt   DateTime?
  createdAt     DateTime @default(now())
  bot           Bot?
  deliveries    WebhookDelivery[]
}

model WebhookDelivery {
  id          String   @id @map("_id") @default(auto()) @db.ObjectId
  endpointId  String   @db.ObjectId
  nonce       String
  payloadHash String
  status      String   @default("PENDING")
  attempts    Int      @default(0)
  receivedAt  DateTime @default(now())
  processedAt DateTime?
  error       String?
  botsRouted  Int      @default(0)
  botsFailed  Int      @default(0)
  endpoint    WebhookEndpoint @relation(fields: [endpointId], references: [id])
  @@index([status, receivedAt])
}

model ExchangeAccount {
  id          String   @id @map("_id") @default(auto()) @db.ObjectId
  exchange    String
  marketType  String
  label       String?
  apiKey      String
  apiSecret   String
  isPrimary   Boolean  @default(false)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
  bots        Bot[]
  @@index([isPrimary])
}

model Bot {
  id                String           @id @map("_id") @default(auto()) @db.ObjectId
  name              String
  type              String           @default("WEBHOOK")
  status            String           @default("ACTIVE")
  activeVersion     Int              @default(1)
  config            Json
  exchangeAccountId String?          @db.ObjectId
  webhookId         String?          @unique @db.ObjectId
  createdAt         DateTime         @default(now())
  updatedAt         DateTime         @updatedAt
  exchangeAccount   ExchangeAccount? @relation(fields: [exchangeAccountId], references: [id])
  webhook           WebhookEndpoint? @relation(fields: [webhookId], references: [id])
  versions          BotVersion[]
  runs              BotRun[]
}

model BotVersion {
  id        String   @id @map("_id") @default(auto()) @db.ObjectId
  botId     String   @db.ObjectId
  version   Int
  config    Json
  checksum  String
  createdAt DateTime @default(now())
  bot       Bot      @relation(fields: [botId], references: [id])
  @@unique([botId, version])
}

model BotRun {
  id        String   @id @map("_id") @default(auto()) @db.ObjectId
  botId     String   @db.ObjectId
  startedAt DateTime @default(now())
  stoppedAt DateTime?
  status    String
  metrics   Json
  bot       Bot      @relation(fields: [botId], references: [id])
  @@index([botId, startedAt])
}

model OrderIntent {
  id              String      @id @map("_id") @default(auto()) @db.ObjectId
  idempotencyKey  String
  clientOrderId   String
  symbol          String
  side            String
  positionSide    String
  orderType       String
  marketType      String
  quantity        String
  price           String?
  stopPrice       String?
  leverage        Int?
  marginMode      String?
  reduceOnly      Boolean     @default(false)
  postOnly        Boolean     @default(false)
  allocation      Json?
  state           String      @default("QUEUED")
  rejectionReason String?
  exchangeOrderId String?
  exchangeAccountId String? @db.ObjectId
  source          Json?
  createdAt       DateTime    @default(now())
  updatedAt       DateTime    @updatedAt
  executions      Execution[]
  @@unique([idempotencyKey])
  @@index([state, createdAt])
}

model Execution {
  id                  String      @id @map("_id") @default(auto()) @db.ObjectId
  orderIntentId       String      @db.ObjectId
  exchangeExecutionId String
  quantity            String
  price               String
  fee                 String      @default("0")
  feeAsset            String?
  executedAt          DateTime    @default(now())
  createdAt           DateTime    @default(now())
  orderIntent         OrderIntent @relation(fields: [orderIntentId], references: [id])
  @@unique([orderIntentId, exchangeExecutionId])
}

model Position {
  id                String   @id @map("_id") @default(auto()) @db.ObjectId
  symbol            String
  side              String
  marginMode        String   @default("ISOLATED")
  quantity          String
  averageEntryPrice String
  markPrice         String
  liquidationPrice  String?
  leverage          Int      @default(1)
  unrealizedPnl     String
  realizedPnl       String
  updatedAt         DateTime @updatedAt
  @@unique([symbol, side])
}

model Notification {
  id        String   @id @map("_id") @default(auto()) @db.ObjectId
  channel   String
  severity  String   @default("INFO")
  title     String
  message   String?
  payload   Json?
  readAt    DateTime?
  createdAt DateTime @default(now())
  @@index([createdAt])
}

model MarketCache {
  id        String   @id @map("_id") @default(auto()) @db.ObjectId
  key       String   @unique
  payload   Json
  updatedAt DateTime @updatedAt
}

model BotState {
  id        String   @id @map("_id") @default(auto()) @db.ObjectId
  botId     String   @unique @db.ObjectId
  state     Json
  updatedAt DateTime @updatedAt
}
