{
  "name": "@platform/database",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": { ".": { "types": "./src/index.ts", "import": "./dist/index.js" } },
  "scripts": {
    "generate": "node --env-file-if-exists=../../.env ./node_modules/prisma/build/index.js generate --schema prisma/schema.prisma",
    "validate": "node --env-file-if-exists=../../.env ./node_modules/prisma/build/index.js validate --schema prisma/schema.prisma",
    "build": "node --env-file-if-exists=../../.env ./node_modules/prisma/build/index.js generate --schema prisma/schema.prisma && tsc -p tsconfig.json",
    "lint": "node --env-file-if-exists=../../.env ./node_modules/prisma/build/index.js validate --schema prisma/schema.prisma",
    "typecheck": "node --env-file-if-exists=../../.env ./node_modules/prisma/build/index.js validate --schema prisma/schema.prisma",
    "test": "node --env-file-if-exists=../../.env ./node_modules/prisma/build/index.js validate --schema prisma/schema.prisma",
    "test:coverage": "node --env-file-if-exists=../../.env ./node_modules/prisma/build/index.js validate --schema prisma/schema.prisma"
  },
  "dependencies": { "@prisma/client": "^6.6.0", "@platform/security": "workspace:*" },
  "devDependencies": { "prisma": "^6.6.0" }
}
