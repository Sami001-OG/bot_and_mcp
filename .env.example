# Single-user Next.js trading app — local dev on this machine (no apps/web/.env; Next loads from the app dir, so these are loaded into the process env before `next start`).
NODE_ENV=production

# Local single-node replica set (mongod 7.0.14 --replSet rs0). Swap for the MongoDB Atlas URI when ready.
DATABASE_URL=mongodb://127.0.0.1:27017/tradingbot

# Auth
APP_PASSWORD=replace-with-a-strong-password
SESSION_SECRET=replace-with-at-least-32-characters
MCP_PASSWORD=replace-with-a-strong-password
CRON_SECRET=replace-with-at-least-32-characters

# Credential encryption at rest (ExchangeAccount.apiSecret = AES-256-GCM "v1:<iv>:<tag>:<ct>"); 64-hex or 32-byte base64. Keep secret + stable.
ENCRYPTION_KEY=replace-with-a-64-char-hex-string

# Webhook signing enforcement (HMAC-SHA256 of the raw body as x-tradingview-signature)
WEBHOOK_REQUIRE_SIGNATURE=true

# NOT read by the app anymore — user enters exchange credentials in the UI (/accounts), encrypted into MongoDB.
# BYBIT_API_KEY=
# BYBIT_SECRET_KEY=